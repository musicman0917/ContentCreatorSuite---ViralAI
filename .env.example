# ────────────────────────────────────────────────────────────
# ViralAudit AI — environment template.
# Copy this file to ".env" and fill in real values.
# ".env" is gitignored and must NEVER be committed.
# ────────────────────────────────────────────────────────────

# ── Backend (viral-audit-server.cjs, loaded via dotenv) ──────
GROQ_API_KEY=gsk_your_groq_key_here
VIRAL_AUDIT_PORT=3015
VIRAL_AUDIT_MAX_MB=500
VIRAL_AUDIT_CORS_ORIGIN=*

# Optional: absolute path to TwitchDownloaderCLI (chat replay).
# Leave blank if it is already on PATH.
TWITCH_DL_PATH=

# Optional: where version-history snapshots are stored.
# Defaults to "D:\ViralAudit history" if unset.
VIRAL_HISTORY_DIR=

# ── Frontend (Vite — only VITE_* vars reach the browser) ─────
# NOTE: any VITE_ var is bundled into client-side JS and is
# visible to anyone who loads the app. See CLAUDE.md → Security.
VITE_ANTHROPIC_API_KEY=sk-ant-your_rotated_key_here
VITE_BACKEND_URL=http://192.168.6.228:3015
